# Copy to .sandcastle/.env and fill in. Values must be lines in that file —
# shell exports are ignored (sandcastle only injects keys it finds there).
# See .sandcastle/setup.md for how to obtain each key.

# `claude setup-token`. Bills your Claude subscription. Do NOT also set
# ANTHROPIC_API_KEY — if present, Claude Code prefers it and bills the API.
CLAUDE_CODE_OAUTH_TOKEN=

# Fine-grained PAT scoped to Frame-Payments/frame-cli: Contents + Issues +
# Pull requests (read/write), Metadata (read-only). Needs org approval (#devs).
GH_TOKEN=

# https://linear.app/framepayments/settings/account/security
LINEAR_API_KEY=
